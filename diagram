<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Pipeline architecture</title>
  <script type="module">
    import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";
    mermaid.initialize({ startOnLoad: true, theme: "default" });
  </script>
</head>
<body>
  <pre class="mermaid">
flowchart TB
  subgraph inputs [Inputs]
    Manifest[dataset_manifest.csv]
    PDFs[data/bills PDFs]
    GT[data/ground_truth JSON]
    PromptFile[prompts extraction template]
    Config[YAML config plus CLI overrides]
  end
  Manifest --> DatasetLoader
  Config --> LoadCfg
  LoadCfg --> RunPipeline
  subgraph loader [Dataset layer]
    DatasetLoader[DatasetLoader load_and_validate]
    DocEntry[DocumentEntry rows]
    DatasetLoader --> DocEntry
  end
  PDFs --> DatasetLoader
  DocEntry --> RunPipeline
  subgraph runSetup [Run setup]
    RunPipeline[pipeline run_pipeline]
    Snapshots[snapshot config manifest prompt]
    RunPipeline --> Snapshots
  end
  PromptFile --> Snapshots
  RunPipeline --> Resume
  subgraph perDoc [Per document]
    Resume{extraction exists and not force}
    Process[_process_document]
    Resume -->|skip| NextDoc[next document]
    Resume -->|process| Process
    Process --> NextDoc
  end
  Process --> PdfToImg
  PdfToImg --> Mode
  subgraph branch [Mode branch]
    Mode{pipeline mode}
    OCR[Tesseract per page]
    Concat[concatenate OCR text]
    Mode -->|ocr_text| OCR
    OCR --> Concat
    VisionPages[first 2 pages baseline]
    Mode -->|vision| VisionPages
  end
  Concat --> Provider
  VisionPages --> Provider
  RenderPrompt[render prompt] --> Provider
  Snapshots --> RenderPrompt
  subgraph llm [LLM layer]
    Provider[LLMProvider]
    OpenAI[OpenAI Structured Outputs]
    Anthropic[Anthropic JSON]
    Provider --> OpenAI
    Provider --> Anthropic
  end
  Provider --> Parse
  Parse --> Norm
  Norm --> ModelOut
  ModelOut --> ExtractionJSON
  ExtractionJSON --> EvalRun
  GT --> EvalRun
  EvalRun --> Compare
  Compare --> Report
  </pre>
</body>
</html>